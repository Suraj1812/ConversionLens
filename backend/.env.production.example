NODE_ENV=production
# Railway injects PORT automatically. Leave it unset in Railway unless you need to override it.
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SSL=false
DATABASE_MAX_POOL_SIZE=20
CORS_ORIGIN=https://conversionlens.vercel.app
TRUST_PROXY=true
AUTH_COOKIE_NAME=shoplytics_session
AUTH_SESSION_DAYS=7
ADMIN_EMAIL=admin@Shoplytics.com
ADMIN_PASSWORD=Suraj@123
ADMIN_NAME=Shoplytics Admin
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500
DEFAULT_WINDOW_DAYS=30
